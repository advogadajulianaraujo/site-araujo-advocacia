{
  "manifest_version": 3,
  "name": "Araújo Advocacia — Assistente do WhatsApp",
  "short_name": "Assistente Araújo",
  "version": "1.3.1",
  "description": "Mostra ao lado de cada conversa do WhatsApp Web quem é a pessoa no painel do escritório (cliente, etapa do funil, processos) e ajuda a seguir o atendimento. Também lê o DJEN (diário eletrônico) de 2 em 2 horas com o Chrome aberto.",
  "icons": {
    "16": "icones/a16.png",
    "32": "icones/a32.png",
    "48": "icones/a48.png",
    "128": "icones/a128.png"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://comunicaapi.pje.jus.br/*"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://araujoadvocaciasc.com.br/painel/*",
        "https://www.araujoadvocaciasc.com.br/painel/*"
      ],
      "js": [
        "ponte.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Assistente Araújo Advocacia",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icones/a16.png",
      "32": "icones/a32.png"
    }
  }
}